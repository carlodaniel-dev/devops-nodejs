{
  "name": "demo",
  "version": "1.0.0",
  "description": "Demo DevOps API (users) - Node.js + Express + PostgreSQL",
  "main": "index.js",
  "type": "module",
  "engines": {
    "node": ">=20.6"
  },
  "scripts": {
    "start": "node index.js",
    "dev": "node --env-file=.env index.js",
    "migrate": "node scripts/migrate.js",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "lint": "eslint ."
  },
  "jest": {
    "testEnvironment": "node",
    "transform": {
      "^.+\\.js?$": "babel-jest"
    },
    "collectCoverageFrom": [
      "app.js",
      "users/**/*.js",
      "shared/**/*.js"
    ],
    "coverageReporters": [
      "text",
      "lcov"
    ],
    "coverageThreshold": {
      "global": {
        "statements": 80,
        "branches": 80,
        "functions": 80,
        "lines": 80
      }
    }
  },
  "author": "Devsu",
  "dependencies": {
    "express": "4.22.3",
    "pg": "8.13.1",
    "pg-hstore": "2.3.4",
    "sequelize": "6.37.8",
    "yup": "1.0.2"
  },
  "devDependencies": {
    "@babel/preset-env": "7.21.4",
    "@eslint/js": "9.17.0",
    "@types/express": "4.17.17",
    "babel-jest": "29.5.0",
    "eslint": "9.17.0",
    "globals": "15.14.0",
    "jest": "29.5.0",
    "supertest": "6.3.3"
  }
}